# Derived or heavy files. Everything here is regenerated by the scripts in pipeline/
# (see docs/PIPELINE.md).
__pycache__/
node_modules/
*.pyc

# plate frames are extracted from work/gen/plates/*.mp4 by pipeline/extract_frames.py
renderer/assets/plates/*/f*.jpg

# audio intermediates (pipeline/sfx.py, work/audio/*.py regenerate them)
work/audio/*.wav
work/audio/*.mp3
work/audio/stems/
work/audio/*.npz

# render scratch
work/segments/
work/bench/
work/models/
work/tests/
work/proto/
work/mouth/
work/relay/
work/*.log
work/gen/*.log
out/*_segments/
work/*.mp4
work/stills/
